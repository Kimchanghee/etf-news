---
import {site} from '../site.config';import '../styles/global.css';const {title,description,kind='WebPage'}=Astro.props;const canonical=new URL(Astro.url.pathname,site.domain).href;
---
<!doctype html><html lang="en"><head><meta charset="UTF-8"/><meta name="viewport" content="width=device-width"/><title>{title}</title><meta name="description" content={description}/><link rel="canonical" href={canonical}/><meta property="og:title" content={title}/><meta property="og:description" content={description}/><meta property="og:type" content="website"/><meta property="og:url" content={canonical}/><meta property="og:image" content={site.domain+'/og/default.png'}/><link rel="alternate" type="application/rss+xml" title="ETF field guides" href="/rss.xml"/><meta name="twitter:card" content="summary_large_image"/><meta name="google-adsense-account" content={site.adsenseClient}/>{site.gscVerification&&<meta name="google-site-verification" content={site.gscVerification}/>}<script type="application/ld+json" set:html={JSON.stringify({'@context':'https://schema.org','@graph':[{'@type':'Organization','@id':site.domain+'/#organization',name:site.name,description:site.description,url:site.domain},{'@type':'WebSite',name:site.name,url:site.domain},{'@type':kind,name:title,url:canonical,description}]}).replaceAll('<','\u003c')}/></head><body><a class="skip" href="#main">Skip to content</a><header><a class="brand" href="/">ETF NEWS DAILY / THE FEE METER</a><nav aria-label="Primary"><a href="/tools/">Cost tools</a><a href="/filings/">Filings desk</a><a href="/guides/">Field guides</a></nav></header><main id="main"><p class="eyebrow">The cost of owning a fund</p><slot/></main><footer><p>{site.description}</p><nav aria-label="Information">{['about','methodology','contact','privacy','terms','disclaimer'].map(p=><a href={'/'+p+'/'}>{p[0].toUpperCase()+p.slice(1)}</a>)}</nav><p>Educational models, not investment or tax advice. No fund recommendations. No affiliate links currently configured.</p></footer></body></html>