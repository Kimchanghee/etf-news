---
import Layout from '../../layouts/Layout.astro';
import tools from '../../data/tools.json';
import AdSlot from '../../components/AdSlot.astro';
import {site} from '../../site.config';
export function getStaticPaths(){
return tools.map(([tool,name,q])=>({params:{tool},props:{name,q}}));
}
const {name,q}=Astro.props;
const {tool}=Astro.params;
const fields=[['amount','Starting amount',10000,1,1000000000],['years','Whole years',10,0,100],['r','Annual return before costs (%)',5,-99,100],['er','Expense ratio / fund A (%)',0.2,0,20],...(tool==='expense-ratio'?[['contribution','Start-of-year contribution',0,0,1000000000]]:[]),...(tool==='total-cost'?[['spread','Full bid–ask spread (%)',0.1,0,20],['commission','Commission per trade',0,0,100000]]:[]),...(tool==='fund-comparison'?[['erB','Mutual fund expense ratio (%)',0.8,0,20],['load','Mutual fund purchase load (%)',0,0,50]]:[]),...(tool==='withholding'?[['yield','Annual dividend yield (%)',2,0,50],['level1','Source-to-fund withholding (%)',15,0,100],['level2','Fund-to-investor withholding (%)',0,0,100]]:[])];
---
<Layout title={name+' | Transparent ETF Calculator Desk'} description={'Explore '+name.toLowerCase()+' with editable assumptions and transparent calculations. Compare a cost-free baseline and read our full model methodology here.'} kind="WebApplication"><h1>{q}</h1><p class="lead">{name} is calculated from your assumptions. Rates are entered as percentages; results use the same currency units as the starting amount.</p><p class="note">Model conventions last revised <time datetime={site.modelsRevised}>{site.modelsRevised}</time>. No live market prices are used.</p><div class="desk"><form data-tool={tool}><div class="fields">{fields.map(([id,label,value,min,max])=><label>{label}<input name={String(id)} type="number" value={value} min={min} max={max} step={id==='years'?'1':'any'} required/></label>)}</div><button>Calculate costs</button><output aria-live="polite">Enter your assumptions and calculate.</output></form><aside class="meter"><h2>Read the model first.</h2><p>Constant returns are illustrative. Negative return assumptions are supported. Results do not predict a fund’s performance.</p><p>{tool==='fund-comparison'?'This comparison isolates annual expenses and the mutual fund purchase load. Both funds use the same gross return; distributions, tax, ETF spread and commissions are zero in this view.':tool==='withholding'?'Both withholding rates are user assumptions, not domicile-specific tax advice. No tax credit or reclaim is modeled. The 15% example is not a universal treaty rate.':'Expense ratios apply after the annual gross return. Contributions, if present, arrive at the start of each year. Trading cost uses half the spread on purchase and half on sale.'}</p><a href="/methodology/">Formulas and limitations →</a><p><a href="/guides/">ETF field guides →</a></p></aside></div><AdSlot/></Layout>
<script>
import {feeDrag,ownershipCost,etfVsMutualFund,withholding} from '../../lib/calc';const form=document.querySelector('form')!;form.addEventListener('submit',e=>{e.preventDefault();const o=form.querySelector('output')!;const data=new FormData(form);const n=(k:string)=>Number(data.get(k));const money=(v:number)=>v.toLocaleString('en-US',{maximumFractionDigits:2});try{if(!form.checkValidity())return;const amount=n('amount'),years=n('years'),r=n('r')/100,er=n('er')/100;let text='';switch(form.dataset.tool){case'expense-ratio':{const d=feeDrag({initial:amount,contribution:n('contribution'),years,r,er});text='Net value: '+money(d.net)+' · Total cost vs zero fees: '+money(d.totalCost)+' · Fees paid: '+money(d.feesPaid);break}case'total-cost':{if(n('commission')>=amount*(1-n('spread')/200))throw Error('Commission leaves no investable balance.');const d=ownershipCost({amount,years,r,er,spread:n('spread')/100,commission:n('commission')});text='Sale proceeds: '+money(d.proceeds)+' · Cost vs zero-cost baseline: '+money(d.cost);break}case'fund-comparison':{const d=etfVsMutualFund({amount,years,r,etf:{er,spread:0,commission:0,distRate:0},fund:{er:n('erB')/100,load:n('load')/100,distRate:0},taxRate:0});text='ETF: '+money(d.etfEnd)+' · Mutual fund: '+money(d.fundEnd)+' · ETF minus mutual fund: '+money(d.difference);break}default:{const d=withholding({amount,years,r,yield:n('yield')/100,level1:n('level1')/100,level2:n('level2')/100});if(1+r-d.drag<0)throw Error('Return minus withholding drag cannot be below −100%.');text='Annual withholding: '+money(d.annualLeak)+' · Effective dividend tax: '+money(d.effectiveRate*100)+'% · Modeled cumulative difference: '+money(d.cumulative)}}if(/Infinity|NaN/.test(text))throw Error('Inputs exceed the finite model range.');o.textContent=text;o.className='';(window as Window & {gtag?: (...args: unknown[])=>void}).gtag?.('event','tool_used',{tool_name:form.dataset.tool});}catch(err){o.className='error';o.textContent=err instanceof Error?err.message:'Invalid inputs';}});
</script>
