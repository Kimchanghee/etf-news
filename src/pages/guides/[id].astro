---
import {getCollection,render} from 'astro:content';
import Layout from '../../layouts/Layout.astro';
import {site} from '../../site.config';
export async function getStaticPaths(){return (await getCollection('guides')).map(entry=>({params:{id:entry.id},props:{entry}}));}
const {entry}=Astro.props;const {Content}=await render(entry);const d=entry.data;const url=site.domain+'/guides/'+entry.id+'/';
const related=(await getCollection('guides')).filter(g=>g.id!==entry.id);
const schema={'@context':'https://schema.org','@graph':[{'@type':'Article',headline:d.question,description:d.answer,dateModified:d.updated,datePublished:d.updated,mainEntityOfPage:url,author:{'@type':'Organization',name:site.name,url:site.domain+'/about/'},publisher:{'@id':site.domain+'/#organization'},citation:d.sources.map(s=>s.url)},{'@type':'BreadcrumbList',itemListElement:[{'@type':'ListItem',position:1,name:'Home',item:site.domain+'/'},{'@type':'ListItem',position:2,name:'Field guides',item:site.domain+'/guides/'},{'@type':'ListItem',position:3,name:d.question,item:url}]},{'@type':'FAQPage',mainEntity:d.faq.map(f=>({'@type':'Question',name:f.question,acceptedAnswer:{'@type':'Answer',text:f.answer}}))}]};
---
<Layout title={d.title} description={d.description} kind="Article"><article class="paper guide"><nav aria-label="Breadcrumb"><a href="/">Home</a><a href="/guides/">Field guides</a></nav><h1>{d.question}</h1><p class="lead">{d.answer}</p><p class="note">By ETF News Daily editorial desk · Updated <time datetime={d.updated}>{d.updated}</time> · Sources inspected {d.data_asof}</p><Content/><section aria-labelledby="faq"><h2 id="faq">Frequently asked questions</h2>{d.faq.map(f=><section><h3>{f.question}</h3><p>{f.answer}</p></section>)}</section><section aria-labelledby="sources"><h2 id="sources">Official sources and scope</h2><p>These SEC staff education materials explain concepts, not an endorsement of any fund. Worked examples here are hypothetical, not observed market prices or forecasts.</p><ul>{d.sources.map(s=><li><a href={s.url}>{s.title}</a></li>)}</ul></section><aside><h2>Continue the cost check</h2><ul>{related.map(g=><li><a href={'/guides/'+g.id+'/'}>{g.data.question}</a></li>)}</ul><p><a href="/tools/">Use the calculators</a> · <a href="/methodology/">Read our model assumptions</a></p></aside><p class="note">Educational information, not investment or tax advice.</p></article><script type="application/ld+json" set:html={JSON.stringify(schema).replaceAll('<','\u003c')}/></Layout>